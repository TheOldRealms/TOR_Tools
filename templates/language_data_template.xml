  <LanguageFile xml_path="{LANG}/TOR_Core/ModuleData/tor_npccharacters/tor_dummyNPCs.xml" />

  <!-- ═══════════════════════════════════════════════════════════════════════════
       TOR_Core - Townspeople (by culture)
       ═══════════════════════════════════════════════════════════════════════════ -->
  <LanguageFile xml_path="{LANG}/TOR_Core/ModuleData/tor_townspeople/tor_townspeople_asrai.xml" />
