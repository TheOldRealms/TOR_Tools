{
  "file": "tor_rangedweapons.xml",
  "displayName": "Ranged Weapons",
  "description": "Ranged weapon definitions (crossbows, bows, guns, throwing weapons).",
  "rootElement": "Items",
  "entryElement": "Item",
  "fields": {
    "id": {
      "displayName": "ID",
      "description": "Unique identifier for this weapon.",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 280
    },
    "name": {
      "displayName": "Name",
      "description": "Display name with localization key.",
      "type": "string",
      "required": true,
      "order": 2,
      "width": 200
    },
    "Type": {
      "displayName": "Type",
      "description": "Weapon type category.",
      "type": "enum",
      "order": 5,
      "width": 100,
      "enumValues": [
        { "value": "Crossbow", "displayName": "Crossbow" },
        { "value": "Bow", "displayName": "Bow" },
        { "value": "Musket", "displayName": "Musket" },
        { "value": "Pistol", "displayName": "Pistol" },
        { "value": "Thrown", "displayName": "Thrown" }
      ]
    },
    "culture": {
      "displayName": "Culture",
      "description": "Cultural origin of this weapon. Click to navigate to culture definition.",
      "type": "crossReference",
      "renderAs": "dropdown",
      "order": 10,
      "width": 140,
      "crossReference": {
        "targetFile": "tor_cultures.xml",
        "targetKeyField": "id",
        "targetDisplayField": "name",
        "localKeyField": "culture",
        "prefixToStrip": "Culture.",
        "prefixToAdd": "Culture."
      }
    },
    "RaceLock": {
      "displayName": "Race Lock",
      "description": "Race restriction for this weapon (from extended properties).",
      "type": "crossReference",
      "renderAs": "dropdown",
      "order": 11,
      "width": 100,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "@RaceLock",
        "localKeyField": "id",
        "targetFile": "tor_races.xml",
        "targetKeyField": "id",
        "targetDisplayField": "displayName",
        "singleValue": true
      }
    },
    "is_merchandise": {
      "displayName": "Merchandise",
      "description": "Whether this item appears in shops.",
      "type": "enum",
      "order": 15,
      "width": 90,
      "default": "true",
      "enumValues": [
        { "value": "true", "displayName": "Yes" },
        { "value": "false", "displayName": "No" }
      ]
    },
    "value": {
      "displayName": "Value",
      "description": "Base price in denars.",
      "type": "int",
      "min": 0,
      "max": 1000000,
      "order": 20,
      "width": 80
    },
    "weight": {
      "displayName": "Weight",
      "description": "Item weight in kg.",
      "type": "float",
      "order": 21,
      "width": 70
    },
    "appearance": {
      "displayName": "Appearance",
      "description": "Rarity/spawn frequency of the item.",
      "type": "float",
      "order": 22,
      "width": 80
    },
    "difficulty": {
      "displayName": "Difficulty",
      "description": "Skill requirement to use effectively.",
      "type": "int",
      "order": 25,
      "width": 70
    },
    "mesh": {
      "displayName": "Mesh",
      "description": "3D mesh asset name.",
      "type": "string",
      "order": 30,
      "width": 200
    },
    "DamageProportions": {
      "displayName": "Damage",
      "description": "Damage type proportions dealt by this weapon.",
      "type": "tupleList",
      "order": 65,
      "width": 180,
      "tupleList": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "containerPath": "DamageProportions",
        "elementName": "DamageProportionTuple",
        "localKeyField": "id",
        "columns": [
          { "attribute": "DamageType", "displayName": "Type", "type": "enum", "width": 80, "enumValues": ["Physical", "Fire", "Frost", "Lightning", "Holy", "Magical", "All"] },
          { "attribute": "Percent", "displayName": "%", "type": "number", "width": 50 }
        ]
      }
    },
    "ItemTraits": {
      "displayName": "Item Traits",
      "description": "Traits assigned to this item (from extended properties).",
      "type": "crossReference",
      "order": 70,
      "width": 200,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "ItemTraits/ItemTrait",
        "targetFile": "tor_itemtraits.xml",
        "targetKeyField": "ItemTraitStringId",
        "localKeyField": "id"
      }
    }
  }
}
