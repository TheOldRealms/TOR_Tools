{
  "file": "tor_projectiles.xml",
  "displayName": "Projectiles",
  "description": "Ammunition and projectile definitions including bullets, arrows, bolts, and thrown weapons.",
  "rootElement": "Items",
  "entryElement": "Item",
  "fields": {
    "id": {
      "displayName": "ID",
      "description": "Unique identifier for this projectile.",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 250
    },
    "name": {
      "displayName": "Name",
      "description": "Display name with localization key.",
      "type": "string",
      "required": true,
      "order": 2,
      "width": 200
    },
    "Type": {
      "displayName": "Type",
      "description": "Projectile type category.",
      "type": "enum",
      "required": true,
      "order": 5,
      "width": 120,
      "enumValues": [
        { "value": "Bullets", "displayName": "Bullets", "description": "Firearm ammunition" },
        { "value": "Arrows", "displayName": "Arrows", "description": "Bow ammunition" },
        { "value": "Bolts", "displayName": "Bolts", "description": "Crossbow ammunition" },
        { "value": "Thrown", "displayName": "Thrown", "description": "Throwable projectiles" }
      ]
    },
    "mesh": {
      "displayName": "Mesh",
      "description": "3D model mesh file.",
      "type": "string",
      "order": 10,
      "width": 180
    },
    "flying_mesh": {
      "displayName": "Flying Mesh",
      "description": "Mesh used when projectile is in flight.",
      "type": "string",
      "order": 11,
      "width": 180
    },
    "weight": {
      "displayName": "Weight",
      "description": "Item weight in kg.",
      "type": "number",
      "order": 15,
      "width": 80
    },
    "value": {
      "displayName": "Value",
      "description": "Base gold value.",
      "type": "number",
      "order": 20,
      "width": 100
    },
    "is_merchandise": {
      "displayName": "Merchandise",
      "description": "Whether this item appears in shops.",
      "type": "enum",
      "order": 25,
      "width": 100,
      "enumValues": [
        { "value": "true", "displayName": "Yes", "description": "Available in shops" },
        { "value": "false", "displayName": "No", "description": "Not sold in shops" }
      ]
    },
    "culture": {
      "displayName": "Culture",
      "description": "Cultural origin of this item. Click to navigate to culture definition.",
      "type": "crossReference",
      "renderAs": "dropdown",
      "order": 30,
      "width": 140,
      "crossReference": {
        "targetFile": "tor_cultures.xml",
        "targetKeyField": "id",
        "targetDisplayField": "name",
        "localKeyField": "culture",
        "prefixToStrip": "Culture.",
        "prefixToAdd": "Culture."
      }
    },
    "weapon_class": {
      "displayName": "Weapon Class",
      "description": "Weapon class from nested Weapon component.",
      "type": "enum",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@weapon_class",
      "order": 40,
      "width": 120,
      "enumValues": [
        { "value": "Cartridge", "displayName": "Cartridge", "description": "Firearm ammunition" },
        { "value": "Arrow", "displayName": "Arrow", "description": "Bow ammunition" },
        { "value": "Bolt", "displayName": "Bolt", "description": "Crossbow ammunition" },
        { "value": "Boulder", "displayName": "Boulder", "description": "Large projectile" },
        { "value": "ThrowingKnife", "displayName": "Throwing Knife" },
        { "value": "ThrowingAxe", "displayName": "Throwing Axe" },
        { "value": "Javelin", "displayName": "Javelin" }
      ]
    },
    "stack_amount": {
      "displayName": "Stack Amount",
      "description": "Number of projectiles per stack.",
      "type": "number",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@stack_amount",
      "order": 45,
      "width": 100
    },
    "missile_speed": {
      "displayName": "Missile Speed",
      "description": "Flight speed of the projectile.",
      "type": "number",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@missile_speed",
      "order": 50,
      "width": 100
    },
    "thrust_damage": {
      "displayName": "Damage",
      "description": "Base damage value.",
      "type": "number",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@thrust_damage",
      "order": 55,
      "width": 80
    },
    "thrust_damage_type": {
      "displayName": "Damage Type",
      "description": "Type of damage dealt.",
      "type": "enum",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@thrust_damage_type",
      "order": 60,
      "width": 100,
      "enumValues": [
        { "value": "Pierce", "displayName": "Pierce" },
        { "value": "Blunt", "displayName": "Blunt" },
        { "value": "Cut", "displayName": "Cut" }
      ]
    },
    "DamageProportions": {
      "displayName": "Damage",
      "description": "Damage type proportions dealt by this projectile.",
      "type": "tupleList",
      "order": 65,
      "width": 180,
      "tupleList": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "containerPath": "DamageProportions",
        "elementName": "DamageProportionTuple",
        "localKeyField": "id",
        "columns": [
          { "attribute": "DamageType", "displayName": "Type", "type": "enum", "width": 80, "enumValues": ["Physical", "Fire", "Frost", "Lightning", "Holy", "Magical", "All"] },
          { "attribute": "Percent", "displayName": "%", "type": "number", "width": 50 }
        ]
      }
    },
    "ItemTraits": {
      "displayName": "Item Traits",
      "description": "Traits assigned to this item (from extended properties). Click to navigate to trait definition.",
      "type": "crossReference",
      "order": 70,
      "width": 200,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "ItemTraits/ItemTrait",
        "targetFile": "tor_itemtraits.xml",
        "targetKeyField": "ItemTraitStringId",
        "localKeyField": "id"
      }
    },
    "RaceLock": {
      "displayName": "Race Lock",
      "description": "Race restriction for this item (from extended properties).",
      "type": "crossReference",
      "order": 71,
      "width": 100,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "@RaceLock",
        "localKeyField": "id"
      },
      "enumValues": [
        { "value": "human", "displayName": "Human" },
        { "value": "dwarf", "displayName": "Dwarf" },
        { "value": "orc", "displayName": "Orc" },
        { "value": "skeleton", "displayName": "Skeleton" },
        { "value": "wraith", "displayName": "Wraith" },
        { "value": "goblin", "displayName": "Goblin" },
        { "value": "ungor", "displayName": "Ungor" },
        { "value": "gor", "displayName": "Gor" },
        { "value": "troll", "displayName": "Troll" },
        { "value": "spirit_host", "displayName": "Spirit Host" }
      ]
    }
  }
}
