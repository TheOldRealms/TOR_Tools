{
  "file": "tor_shields.xml",
  "displayName": "Shields and Offhand",
  "description": "Shields, banners, and offhand items (held in off-hand slot).",
  "rootElement": "Items",
  "entryElement": "Item",
  "fields": {
    "id": {
      "displayName": "ID",
      "description": "Unique identifier for this item.",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 280
    },
    "name": {
      "displayName": "Name",
      "description": "Display name with localization key (e.g., {=str_id}Display Text).",
      "type": "string",
      "required": true,
      "order": 2,
      "width": 200
    },
    "Type": {
      "displayName": "Type",
      "description": "Item type category.",
      "type": "enum",
      "order": 3,
      "width": 120,
      "enumValues": [
        { "value": "Shield", "displayName": "Shield" },
        { "value": "Banner", "displayName": "Banner" },
        { "value": "OneHandedWeapon", "displayName": "One-Handed" }
      ]
    },
    "culture": {
      "displayName": "Culture",
      "description": "Cultural origin of this item. Click to navigate to culture definition.",
      "type": "crossReference",
      "renderAs": "dropdown",
      "order": 10,
      "width": 140,
      "crossReference": {
        "targetFile": "tor_cultures.xml",
        "targetKeyField": "id",
        "targetDisplayField": "name",
        "localKeyField": "culture",
        "prefixToStrip": "Culture.",
        "prefixToAdd": "Culture."
      }
    },
    "RaceLock": {
      "displayName": "Race Lock",
      "description": "Race restriction for this item (from extended properties).",
      "type": "crossReference",
      "renderAs": "dropdown",
      "order": 11,
      "width": 100,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "@RaceLock",
        "localKeyField": "id",
        "targetFile": "tor_races.xml",
        "targetKeyField": "id",
        "targetDisplayField": "displayName",
        "singleValue": true
      }
    },
    "is_merchandise": {
      "displayName": "Merchandise",
      "description": "Whether this item appears in shops.",
      "type": "enum",
      "order": 15,
      "width": 90,
      "default": "true",
      "enumValues": [
        { "value": "true", "displayName": "Yes" },
        { "value": "false", "displayName": "No" }
      ]
    },
    "value": {
      "displayName": "Value (Price)",
      "description": "Base price in denars.",
      "type": "int",
      "min": 0,
      "max": 1000000,
      "order": 20,
      "width": 80
    },
    "weight": {
      "displayName": "Weight",
      "description": "Item weight in kg.",
      "type": "float",
      "min": 0,
      "order": 21,
      "width": 70
    },
    "appearance": {
      "displayName": "Appearance",
      "description": "Rarity/spawn frequency of the item.",
      "type": "float",
      "order": 22,
      "width": 80
    },
    "mesh": {
      "displayName": "Mesh",
      "description": "3D mesh asset name.",
      "type": "string",
      "order": 30,
      "width": 200
    },
    "weapon_class": {
      "displayName": "Weapon Class",
      "description": "Vanilla weapon class on the nested Weapon component. Banner entries use a <Banner> child instead and aren't covered here.",
      "type": "enum",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@weapon_class",
      "order": 40,
      "width": 130,
      "group": "Weapon",
      "enumValues": [
        { "value": "LargeShield", "displayName": "Large Shield" },
        { "value": "SmallShield", "displayName": "Small Shield" },
        { "value": "OneHandedAxe", "displayName": "One-Handed Axe" },
        { "value": "OneHandedSword", "displayName": "One-Handed Sword" },
        { "value": "Mace", "displayName": "Mace" },
        { "value": "Dagger", "displayName": "Dagger" }
      ]
    },
    "hit_points": {
      "displayName": "Hit Points",
      "description": "Shield durability (max damage absorbed before breaking).",
      "type": "int",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@hit_points",
      "order": 41,
      "width": 80,
      "group": "Weapon"
    },
    "body_armor": {
      "displayName": "Body Armor",
      "description": "Passive armor contribution while held (shield-only).",
      "type": "int",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@body_armor",
      "order": 42,
      "width": 80,
      "group": "Weapon"
    },
    "weapon_length": {
      "displayName": "Length",
      "description": "Weapon/shield length (cm).",
      "type": "int",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@weapon_length",
      "order": 43,
      "width": 70,
      "group": "Weapon"
    },
    "weapon_balance": {
      "displayName": "Balance",
      "description": "Weapon balance stat.",
      "type": "int",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@weapon_balance",
      "order": 44,
      "width": 70,
      "group": "Weapon"
    },
    "speed_rating": {
      "displayName": "Speed Rating",
      "description": "Overall swing/block speed rating.",
      "type": "int",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@speed_rating",
      "order": 45,
      "width": 90,
      "group": "Weapon"
    },
    "thrust_speed": {
      "displayName": "Thrust Speed",
      "description": "Thrust attack speed.",
      "type": "int",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@thrust_speed",
      "order": 46,
      "width": 90,
      "group": "Weapon"
    },
    "thrust_damage": {
      "displayName": "Thrust Damage",
      "description": "Thrust damage.",
      "type": "int",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@thrust_damage",
      "order": 47,
      "width": 90,
      "group": "Weapon"
    },
    "thrust_damage_type": {
      "displayName": "Thrust Type",
      "description": "Thrust damage type.",
      "type": "enum",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@thrust_damage_type",
      "order": 48,
      "width": 90,
      "group": "Weapon",
      "enumValues": [
        { "value": "Blunt", "displayName": "Blunt" },
        { "value": "Pierce", "displayName": "Pierce" },
        { "value": "Cut", "displayName": "Cut" }
      ]
    },
    "swing_damage": {
      "displayName": "Swing Damage",
      "description": "Swing damage (offhand weapons).",
      "type": "int",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@swing_damage",
      "order": 49,
      "width": 90,
      "group": "Weapon"
    },
    "swing_damage_type": {
      "displayName": "Swing Type",
      "description": "Swing damage type.",
      "type": "enum",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@swing_damage_type",
      "order": 50,
      "width": 90,
      "group": "Weapon",
      "enumValues": [
        { "value": "Blunt", "displayName": "Blunt" },
        { "value": "Pierce", "displayName": "Pierce" },
        { "value": "Cut", "displayName": "Cut" }
      ]
    },
    "modifier_group": {
      "displayName": "Modifier Group",
      "description": "Vanilla modifier_group key (e.g. shield).",
      "type": "string",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@modifier_group",
      "order": 51,
      "width": 110,
      "group": "Weapon"
    },
    "item_usage": {
      "displayName": "Item Usage",
      "description": "Vanilla item_usage animation set key.",
      "type": "string",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@item_usage",
      "order": 52,
      "width": 110,
      "group": "Weapon"
    },
    "physics_material": {
      "displayName": "Physics Material",
      "description": "Vanilla physics_material key.",
      "type": "string",
      "nested": true,
      "nestedPath": "ItemComponent/Weapon/@physics_material",
      "order": 53,
      "width": 130,
      "group": "Weapon"
    },
    "ItemTraits": {
      "displayName": "Item Traits",
      "description": "Traits assigned to this item (from extended properties). Ctrl+Click to navigate.",
      "type": "crossReference",
      "order": 70,
      "width": 200,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "ItemTraits/ItemTrait",
        "targetFile": "tor_itemtraits.xml",
        "targetKeyField": "ItemTraitStringId",
        "localKeyField": "id"
      }
    }
