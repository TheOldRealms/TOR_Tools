{
  "filePattern": "tor_townspeople_*.xml",
  "displayName": "Townspeople",
  "description": "Per-culture notable NPC templates (merchants, artisans, gang leaders). Shares the NPCCharacter shape with tor_charactertemplates.xml and references equipment rosters from tor_equipment_sets.xml.",
  "rootElement": "NPCCharacters",
  "entryElement": "NPCCharacter",
  "compactFormat": true,
  "fields": {
    "id": {
      "displayName": "ID",
      "description": "Unique identifier for this NPC template.",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 260
    },
    "name": {
      "displayName": "Name",
      "description": "Character name with localization key.",
      "type": "string",
      "order": 2,
      "width": 260
    },
    "culture": {
      "displayName": "Culture",
      "description": "Culture affiliation.",
      "type": "crossReference",
      "renderAs": "dropdown",
      "order": 3,
      "width": 140,
      "crossReference": {
        "targetFile": "tor_cultures.xml",
        "targetKeyField": "id",
        "targetDisplayField": "name",
        "localKeyField": "culture",
        "prefixToStrip": "Culture.",
        "prefixToAdd": "Culture."
      }
    },
    "occupation": {
      "displayName": "Occupation",
      "description": "Vanilla occupation tag (Merchant, Artisan, GangLeader, ...).",
      "type": "string",
      "order": 4,
      "width": 120
    },
    "race": {
      "displayName": "Race",
      "description": "Race id from tor_races.xml.",
      "type": "string",
      "order": 5,
      "width": 100
    },
    "Equipments": {
      "displayName": "Equipment Sets",
      "description": "Equipment set IDs used by this NPC (combat and civilian).",
      "type": "string",
      "order": 10,
      "width": 320,
      "nested": true,
      "nestedPath": "Equipments/EquipmentSet/@id",
      "delimiter": ", "
    }
  }
}
