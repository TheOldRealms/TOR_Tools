{
  "file": "tor_other_items.xml",
  "displayName": "Other Items",
  "description": "Miscellaneous items including artillery, trade goods, books, and special items.",
  "rootElement": "Items",
  "entryElement": "Item",
  "fields": {
    "id": {
      "displayName": "ID",
      "description": "Unique identifier for this item.",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 250
    },
    "name": {
      "displayName": "Name",
      "description": "Display name with localization key.",
      "type": "string",
      "required": true,
      "order": 2,
      "width": 200
    },
    "Type": {
      "displayName": "Type",
      "description": "Item type category.",
      "type": "enum",
      "required": true,
      "order": 5,
      "width": 120,
      "enumValues": [
        { "value": "Goods", "displayName": "Goods", "description": "Trade goods and miscellaneous items" }
      ]
    },
    "mesh": {
      "displayName": "Mesh",
      "description": "3D model mesh file.",
      "type": "string",
      "order": 10,
      "width": 180
    },
    "weight": {
      "displayName": "Weight",
      "description": "Item weight in kg.",
      "type": "number",
      "order": 15,
      "width": 80
    },
    "value": {
      "displayName": "Value",
      "description": "Base gold value.",
      "type": "number",
      "order": 20,
      "width": 100
    },
    "is_merchandise": {
      "displayName": "Merchandise",
      "description": "Whether this item appears in shops.",
      "type": "enum",
      "order": 25,
      "width": 100,
      "enumValues": [
        { "value": "true", "displayName": "Yes", "description": "Available in shops" },
        { "value": "false", "displayName": "No", "description": "Not sold in shops" }
      ]
    },
    "culture": {
      "displayName": "Culture",
      "description": "Cultural origin of this item. Click to navigate to culture definition.",
      "type": "crossReference",
      "renderAs": "dropdown",
      "order": 30,
      "width": 140,
      "crossReference": {
        "targetFile": "tor_cultures.xml",
        "targetKeyField": "id",
        "localKeyField": "culture",
        "prefixToStrip": "Culture.",
        "prefixToAdd": "Culture."
      }
    },
    "prefab": {
      "displayName": "Prefab",
      "description": "Prefab spawner for special items (e.g., artillery).",
      "type": "string",
      "order": 35,
      "width": 180
    },
    "appearance": {
      "displayName": "Appearance",
      "description": "Appearance variant index.",
      "type": "number",
      "order": 40,
      "width": 100
    },
    "ItemTraits": {
      "displayName": "Item Traits",
      "description": "Traits assigned to this item (from extended properties). Click to navigate to trait definition.",
      "type": "crossReference",
      "order": 70,
      "width": 200,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "ItemTraits/ItemTrait",
        "targetFile": "tor_itemtraits.xml",
        "targetKeyField": "ItemTraitStringId",
        "localKeyField": "id"
      }
    },
    "RaceLock": {
      "displayName": "Race Lock",
      "description": "Race restriction for this item (from extended properties).",
      "type": "crossReference",
      "order": 71,
      "width": 100,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "@RaceLock",
        "localKeyField": "id"
      },
      "enumValues": [
        { "value": "human", "displayName": "Human" },
        { "value": "dwarf", "displayName": "Dwarf" },
        { "value": "orc", "displayName": "Orc" },
        { "value": "skeleton", "displayName": "Skeleton" },
        { "value": "wraith", "displayName": "Wraith" },
        { "value": "goblin", "displayName": "Goblin" },
        { "value": "ungor", "displayName": "Ungor" },
        { "value": "gor", "displayName": "Gor" },
        { "value": "troll", "displayName": "Troll" },
        { "value": "spirit_host", "displayName": "Spirit Host" }
      ]
    }
  }
}
