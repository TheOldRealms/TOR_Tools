{
  "file": "tor_strings.xml",
  "displayName": "Strings / Localization",
  "description": "Localized text strings with optional culture/race tags for conditional selection. Can override vanilla Bannerlord strings.",
  "rootElement": "strings",
  "entryElement": "string",
  "compactFormat": true,
  "groupByField": "category",
  "mergedDataFile": {
    "file": "tor_strings_metadata.xml",
    "rootElement": "StringMetadata",
    "entryElement": "String",
    "matchField": "id",
    "fieldMappings": {
      "category": "category",
      "subcategory": "subcategory",
      "comment": "comment"
    }
  },
  "fields": {
    "id": {
      "displayName": "String ID",
      "description": "Unique string identifier. For vanilla overrides, use the hash ID (e.g., 'GAsVO8cZ').",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 250
    },
    "category": {
      "displayName": "Category",
      "description": "Category/section for organization (e.g., 'UI', 'Skills', 'Careers'). Stored in TORTools metadata.",
      "type": "string",
      "order": 2,
      "width": 120,
      "linkedField": true
    },
    "subcategory": {
      "displayName": "Subcategory",
      "description": "Subcategory for finer organization (e.g., 'Grail Knight' under 'Career Perks'). Uses ' - ' separator in XML comments.",
      "type": "string",
      "order": 3,
      "width": 150,
      "linkedField": true
    },
    "text": {
      "displayName": "Text",
      "description": "Display text with localization key prefix (e.g., '{=str_id}Display Text').",
      "type": "string",
      "required": true,
      "order": 4,
      "width": 900,
      "multiline": true
    },
    "tags": {
      "displayName": "Tags",
      "description": "Culture/race/trait tags for conditional string selection (e.g., IsOrcTag, EmpireTag).",
      "type": "tagList",
      "order": 5,
      "width": 200,
      "tagList": {
        "containerElement": "tags",
        "itemElement": "tag",
        "nameAttribute": "tag_name",
        "knownTags": [
          "EmpireTag", "VlandianTag", "SturgianTag", "AseraiTag", "KhuzaitTag", "BattanianTag",
          "AsraiTag", "EonirTag", "MousillonTag", "BloodDragonTag",
          "IsOrcTag", "IsGoblinTag", "IsDwarfTag", "ElfMaleTag", "VampireMaleTag", "VampireFemaleTag",
          "PlayerIsOrcTag", "PlayerIsDwarfTag", "PlayerIsElfTag", "PlayerIsAsraiTag", "PlayerIsEonirTag",
          "PlayerIsEmpireTag", "PlayerIsBretonnianTag",
          "IsWarriorPriestTag", "PlayerIsWarriorPriestTag", "PlayerIsGrailKnightTag",
          "PlayerIsRenownedTag", "IsBretonnianTag", "IsEmpireTag",
          "HonorTag", "MercyTag", "CruelTag", "UncharitableTag"
        ]
      }
    },
    "comment": {
      "displayName": "Comment",
      "description": "Optional documentation comment (stored in TORTools metadata, not in mod files).",
      "type": "string",
      "order": 6,
      "width": 250,
      "linkedField": true,
      "multiline": true
    }
  }
}
