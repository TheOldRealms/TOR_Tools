        { "value": "Culture.vlandia", "displayName": "Bretonnia" },
        { "value": "Culture.khuzait", "displayName": "Sylvania" },
        { "value": "Culture.mousillon", "displayName": "Mousillon" },
        { "value": "Culture.battania", "displayName": "Asrai (Wood Elves)" },
        { "value": "Culture.eonir", "displayName": "Eonir" },
        { "value": "Culture.druchii", "displayName": "Druchii (Dark Elves)" },
        { "value": "Culture.sturgia", "displayName": "Dawi (Dwarfs)" },
        { "value": "Culture.aserai", "displayName": "Greenskin" },
        { "value": "Culture.greenskin_bandit", "displayName": "Greenskin Bandit" },
        { "value": "Culture.steppe_bandits", "displayName": "Beastmen" },
        { "value": "Culture.desert_bandits", "displayName": "Herrimault" },
        { "value": "Culture.chaos_culture", "displayName": "Chaos" },
        { "value": "Culture.neutral_culture", "displayName": "Neutral" }
      ]
    },
