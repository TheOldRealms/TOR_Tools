{
  "file": "tor_armors.xml",
  "displayName": "Armors",
  "description": "Armor piece definitions including body armor, helmets, gloves, and boots.",
  "rootElement": "Items",
  "entryElement": "Item",
  "fields": {
    "id": {
      "displayName": "ID",
      "description": "Unique identifier for this armor piece.",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 220
    },
    "name": {
      "displayName": "Name",
      "description": "Display name with localization key.",
      "type": "string",
      "required": true,
      "order": 2,
      "width": 200
    },
    "Type": {
      "displayName": "Type",
      "description": "Armor type category.",
      "type": "enum",
      "required": true,
      "order": 5,
      "width": 120,
      "enumValues": [
        { "value": "BodyArmor", "displayName": "Body Armor", "description": "Torso protection" },
        { "value": "HeadArmor", "displayName": "Head Armor", "description": "Helmets and headwear" },
        { "value": "HandArmor", "displayName": "Hand Armor", "description": "Gloves and gauntlets" },
        { "value": "LegArmor", "displayName": "Leg Armor", "description": "Boots and leg protection" },
