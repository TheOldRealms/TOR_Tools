{
  "file": "tor_armors.xml",
  "displayName": "Armors",
  "description": "Armor piece definitions including body armor, helmets, gloves, and boots.",
  "rootElement": "Items",
  "entryElement": "Item",
  "fields": {
    "id": {
      "displayName": "ID",
      "description": "Unique identifier for this armor piece.",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 220
    },
    "name": {
      "displayName": "Name",
      "description": "Display name with localization key.",
      "type": "string",
      "required": true,
      "order": 2,
      "width": 200
    },
    "Type": {
      "displayName": "Type",
      "description": "Armor type category.",
      "type": "enum",
      "required": true,
      "order": 5,
      "width": 120,
      "enumValues": [
        { "value": "BodyArmor", "displayName": "Body Armor", "description": "Torso protection" },
        { "value": "HeadArmor", "displayName": "Head Armor", "description": "Helmets and headwear" },
        { "value": "HandArmor", "displayName": "Hand Armor", "description": "Gloves and gauntlets" },
        { "value": "LegArmor", "displayName": "Leg Armor", "description": "Boots and leg protection" },
        { "value": "Cape", "displayName": "Cape", "description": "Cloaks and capes" },
        { "value": "HorseHarness", "displayName": "Horse Harness", "description": "Horse armor and barding" }
      ]
    },
    "subtype": {
      "displayName": "Subtype",
      "description": "Internal subtype (auto-synced with Type).",
      "type": "string",
      "order": 6,
      "hidden": true,
      "autoFillFrom": "Type"
    },
    "culture": {
      "displayName": "Culture",
      "description": "Cultural origin of this item. Click to navigate to culture definition.",
      "type": "crossReference",
      "renderAs": "dropdown",
      "order": 10,
      "width": 140,
      "crossReference": {
        "targetFile": "tor_cultures.xml",
        "targetKeyField": "id",
        "targetDisplayField": "name",
        "localKeyField": "culture",
        "prefixToStrip": "Culture.",
        "prefixToAdd": "Culture."
      }
    },
    "RaceLock": {
      "displayName": "Race Lock",
      "description": "Race restriction for this item (from extended properties).",
      "type": "crossReference",
      "renderAs": "dropdown",
      "order": 11,
      "width": 100,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "@RaceLock",
        "localKeyField": "id",
        "targetFile": "tor_races.xml",
        "targetKeyField": "id",
        "targetDisplayField": "displayName",
        "singleValue": true
      }
    },
    "is_merchandise": {
      "displayName": "Merchandise",
      "description": "Whether this item appears in shops.",
      "type": "enum",
      "order": 20,
      "width": 90,
      "default": "true",
      "enumValues": [
        { "value": "true", "displayName": "Yes" },
        { "value": "false", "displayName": "No" }
      ]
    },
    "value": {
      "displayName": "Value",
      "description": "Base price in denars.",
      "type": "int",
      "min": 0,
      "max": 1000000,
      "order": 21,
      "width": 80
    },
    "weight": {
      "displayName": "Weight",
      "description": "Item weight in kilograms.",
      "type": "float",
      "min": 0,
      "max": 50,
      "order": 22,
      "width": 70
    },
    "appearance": {
      "displayName": "Appearance",
      "description": "Rarity/spawn frequency of the item.",
      "type": "float",
      "order": 50,
      "width": 90
    },
    "mesh": {
      "displayName": "Mesh",
      "description": "3D mesh name.",
