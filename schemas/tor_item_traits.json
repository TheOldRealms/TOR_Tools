{
  "file": "tor_itemtraits.xml",
  "displayName": "Item Traits",
  "description": "Definitions for item traits that provide special effects like bonus damage, status effects, and visual particles.",
  "rootElement": "ItemTraits",
  "entryElement": "ItemTrait",
  "fields": {
    "ItemTraitStringId": {
      "displayName": "ID",
      "description": "Unique identifier for this trait (e.g., runefang, fire_res_amp_10).",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 180
    },
    "ItemTraitName": {
      "displayName": "Name",
      "description": "Display name for the trait.",
      "type": "string",
      "required": true,
      "order": 2,
      "width": 150
    },
    "IsCraftable": {
      "displayName": "Craftable",
      "description": "Whether players can craft items with this trait.",
      "type": "enum",
      "order": 10,
      "width": 80,
      "enumValues": [
        { "value": "true", "displayName": "Yes" },
        { "value": "false", "displayName": "No" }
      ]
    },
    "IconName": {
      "displayName": "Icon",
      "description": "UI icon name for the trait.",
      "type": "string",
      "order": 15,
      "width": 150
    },
    "ImbuedStatusEffectId": {
      "displayName": "Status Effect",
      "description": "Status effect ID applied on hit (optional).",
      "type": "string",
      "order": 20,
      "width": 150
    },
    "ImbuedEffectChance": {
      "displayName": "Effect Chance",
      "description": "Chance to apply the status effect (0.0-1.0).",
      "type": "float",
      "min": 0,
      "max": 1,
      "order": 21,
      "width": 100
    },
    "UsedByItems": {
      "displayName": "Used By Items",
      "description": "Items that have this trait assigned. Ctrl+Click to navigate to item.",
      "type": "reverseCrossReference",
      "order": 99,
      "width": 300,
      "crossReference": {
        "sourceFile": "tor_extendeditemproperties.xml",
        "sourceKeyField": "ItemStringId",
        "sourceValuePath": "ItemTraits/ItemTrait",
        "localKeyField": "ItemTraitStringId",
        "targetFiles": ["tor_armors.xml", "tor_meleeweapons.xml", "tor_shields.xml", "tor_rangedweapons.xml"],
        "targetKeyField": "id"
      }
    }
  },
  "nestedElements": {
    "ValidItemType": {
      "displayName": "Valid Item Type",
      "description": "Item type that can have this trait (Weapon, Armor, etc.)."
    },
    "IngredientItem": {
      "displayName": "Ingredient Item",
      "description": "Item ID required to craft this trait."
    },
    "IngredientAmount": {
      "displayName": "Ingredient Amount",
      "description": "Quantity of ingredient needed."
    },
    "ItemTraitDescription": {
      "displayName": "Description",
      "description": "Localized description text."
    },
    "AdditionalDamageTuple": {
      "displayName": "Additional Damage",
      "description": "Extra damage with DamageType and Percent attributes."
    },
    "WeaponParticlePreset": {
      "displayName": "Particle Effect",
      "description": "Visual particle effects for weapons."
    }
  }
}
