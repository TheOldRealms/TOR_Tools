        "localKeyField": "id",
        "columns": [
          { "attribute": "AmplifiedDamageType", "displayName": "Type", "type": "enum", "width": 80, "enumValues": ["Physical", "Fire", "Frost", "Lightning", "Holy", "Magical", "All"] },
          { "attribute": "DamageAmplifier", "displayName": "%", "type": "number", "width": 50 }
        ]
      }
