      "displayName": "Hero",
      "description": "Is this a hero character.",
      "type": "enum",
      "order": 34,
      "width": 60,
      "enumValues": [
        { "value": "true", "displayName": "Yes" },
        { "value": "false", "displayName": "No" }
      ]
    },
