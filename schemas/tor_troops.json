        { "value": "CaravanGuard", "displayName": "Caravan Guard" },
        { "value": "Wanderer", "displayName": "Wanderer" },
        { "value": "Mercenary", "displayName": "Mercenary" },
        { "value": "Lord", "displayName": "Lord" },
        { "value": "Lady", "displayName": "Lady" },
        { "value": "Merchant", "displayName": "Merchant" },
        { "value": "Artisan", "displayName": "Artisan" },
        { "value": "Headman", "displayName": "Headman" },
        { "value": "GangLeader", "displayName": "Gang Leader" },
        { "value": "Gangster", "displayName": "Gangster" },
        { "value": "RuralNotable", "displayName": "Rural Notable" },
        { "value": "Preacher", "displayName": "Preacher" },
        { "value": "Bandit", "displayName": "Bandit" }
      ]
