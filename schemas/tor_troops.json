      "displayName": "Attributes",
      "description": "Unit attributes. Click to edit or navigate to attribute definition.",
      "type": "crossReference",
      "order": 50,
      "width": 280,
      "crossReference": {
        "sourceFile": "tor_extendedunitproperties.xml",
        "sourceKeyField": "id",
        "sourceValuePath": "Attributes/string",
        "targetFile": "tor_attributes.xml",
        "targetKeyField": "id",
        "localKeyField": "id"
      }
    },
