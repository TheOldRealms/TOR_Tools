      "displayName": "Resistances",
      "description": "Damage type resistances.",
      "type": "tupleList",
      "order": 53,
      "width": 180,
      "tupleList": {
        "sourceFile": "tor_extendedunitproperties.xml",
        "sourceKeyField": "id",
        "containerPath": "Resistances",
        "elementName": "ResistanceTuple",
        "localKeyField": "id",
        "columns": [
          { "attribute": "ResistedDamageType", "displayName": "Type", "type": "enum", "width": 80, "enumValues": ["Physical", "Fire", "Frost", "Lightning", "Holy", "Magical", "All"] },
          { "attribute": "ReductionPercent", "displayName": "%", "type": "number", "width": 50 }
        ]
      }
    },
    "ext_Amplifiers": {
      "displayName": "Amplifiers",
      "description": "Damage amplification bonuses.",
