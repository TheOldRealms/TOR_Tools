    "name": {
      "displayName": "Name",
      "description": "Display name with localization key.",
      "type": "string",
      "required": true,
      "order": 2,
      "width": 200
    },
    "level": {
      "displayName": "Level",
      "description": "Troop tier level.",
      "type": "enum",
      "order": 3,
      "width": 100,
      "enumValues": [
        { "value": "1", "displayName": "1 (Tier 0)" },
        { "value": "6", "displayName": "6 (Tier 1)" },
        { "value": "11", "displayName": "11 (Tier 2)" },
        { "value": "16", "displayName": "16 (Tier 3)" },
        { "value": "21", "displayName": "21 (Tier 4)" },
        { "value": "26", "displayName": "26 (Tier 5)" },
        { "value": "31", "displayName": "31 (Tier 6)" },
        { "value": "36", "displayName": "36 (Tier 7)" },
        { "value": "41", "displayName": "41 (Tier 8)" },
        { "value": "46", "displayName": "46 (Tier 9)" }
      ]
    },
    "default_group": {
      "displayName": "Group",
      "description": "Default formation group.",
      "type": "enum",
      "order": 4,
      "width": 100,
      "enumValues": [
        { "value": "infantry", "displayName": "Infantry" },
        { "value": "ranged", "displayName": "Ranged" },
        { "value": "cavalry", "displayName": "Cavalry" },
        { "value": "horsearcher", "displayName": "Horse Archer" }
      ]
    },
    "culture": {
      "displayName": "Culture",
      "description": "Culture affiliation. Click to navigate to culture definition.",
