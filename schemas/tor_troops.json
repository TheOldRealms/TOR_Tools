{
  "file": "tor_troopdefinitions.xml",
  "displayName": "Troops",
  "description": "Troop and NPC character definitions with upgrade paths and equipment references.",
  "rootElement": "NPCCharacters",
  "entryElement": "NPCCharacter",
  "fields": {
    "id": {
