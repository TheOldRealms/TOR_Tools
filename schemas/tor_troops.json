      "required": true,
      "order": 8,
      "width": 200,
      "crossReference": {
        "targetFile": "tor_skillsets.xml",
        "targetKeyField": "id",
        "localKeyField": "skill_template",
        "prefixToStrip": "SkillSet.",
        "prefixToAdd": "SkillSet."
      }
    },
