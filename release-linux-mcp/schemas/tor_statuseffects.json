      "order": 11,
      "width": 100,
      "enumValues": [
        { "value": "Low", "displayName": "Low" },
        { "value": "High", "displayName": "High" }
      ]
    },
    "do_not_attach_to_agent_skeleton": {
      "displayName": "Detached Particle",
      "description": "Whether particle is detached from agent skeleton.",
      "type": "enum",
      "order": 12,
      "width": 100,
      "enumValues": [
        { "value": "true", "displayName": "Yes" },
        { "value": "false", "displayName": "No" }
      ]
    },
    "base_effect_value": {
      "displayName": "Base Effect Value",
      "description": "Base value for the effect (damage, healing, speed multiplier, etc.).",
      "type": "float",
      "order": 20,
      "width": 120
    },
    "damage_type": {
      "displayName": "Damage Type",
      "description": "Type of damage dealt or amplified.",
      "type": "enum",
      "order": 25,
      "width": 120,
      "enumValues": [
        { "value": "Physical", "displayName": "Physical" },
        { "value": "Fire", "displayName": "Fire" },
        { "value": "Frost", "displayName": "Frost" },
        { "value": "Lightning", "displayName": "Lightning" },
        { "value": "Holy", "displayName": "Holy" },
        { "value": "Magical", "displayName": "Magical" },
        { "value": "All", "displayName": "All" }
      ]
    },
