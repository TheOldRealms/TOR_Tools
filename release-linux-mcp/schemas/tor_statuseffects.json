      "type": "enum",
      "order": 30,
      "width": 120,
      "enumValues": [
        { "value": "Melee", "displayName": "Melee" },
        { "value": "Ranged", "displayName": "Ranged" },
        { "value": "Spell", "displayName": "Spell" },
        { "value": "All", "displayName": "All" }
