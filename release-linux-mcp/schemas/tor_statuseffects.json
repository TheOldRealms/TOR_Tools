{
  "file": "tor_statuseffects.xml",
  "displayName": "Status Effects",
  "description": "Status effect templates for damage over time, buffs, debuffs, and temporary effects.",
  "rootElement": "StatusEffects",
  "entryElement": "StatusEffectTemplate",
  "fields": {
    "id": {
      "displayName": "ID",
      "description": "Unique identifier for this status effect.",
      "type": "string",
      "required": true,
      "order": 1,
      "width": 250
    },
    "type": {
      "displayName": "Type",
      "description": "Type of status effect.",
      "type": "enum",
      "required": true,
      "order": 5,
      "width": 180,
      "enumValues": [
        { "value": "DamageOverTime", "displayName": "Damage Over Time", "description": "Deals damage each tick" },
        { "value": "HealthOverTime", "displayName": "Health Over Time", "description": "Heals health each tick" },
        { "value": "WindsOverTime", "displayName": "Winds Over Time", "description": "Regenerates winds of magic each tick" },
        { "value": "MovementManipulation", "displayName": "Movement Manipulation", "description": "Modifies movement speed" },
        { "value": "AttackSpeedManipulation", "displayName": "Attack Speed Manipulation", "description": "Modifies attack/swing speed" },
        { "value": "ReloadSpeedManipulation", "displayName": "Reload Speed Manipulation", "description": "Modifies reload speed" },
        { "value": "DamageAmplification", "displayName": "Damage Amplification", "description": "Increases damage dealt" },
        { "value": "Resistance", "displayName": "Resistance", "description": "Reduces damage taken" },
        { "value": "LanceSteadiness", "displayName": "Lance Steadiness", "description": "Improves lance charge stability" },
        { "value": "TemporaryAttributeOnly", "displayName": "Temporary Attribute", "description": "Applies temporary attribute without other effects" }
      ]
    },
    "particle_id": {
