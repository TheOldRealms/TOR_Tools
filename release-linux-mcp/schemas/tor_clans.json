      "required": true,
      "order": 1,
      "width": 180
    },
    "name": {
      "displayName": "Name",
      "description": "Display name shown in-game. Localization key is preserved automatically when editing.",
      "type": "string",
      "required": true,
      "order": 2,
      "width": 200
    },
    "owner": {
      "displayName": "Owner",
      "description": "Hero who owns/leads this faction (Hero.* reference).",
      "type": "string",
      "order": 3,
      "width": 220
    },
    "culture": {
      "displayName": "Culture",
      "description": "Culture affiliation. Click to navigate to culture definition.",
      "type": "crossReference",
