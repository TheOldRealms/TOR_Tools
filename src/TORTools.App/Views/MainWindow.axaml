<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TORTools.App.ViewModels"
        xmlns:views="using:TORTools.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="TORTools.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TOR Tools - XML Editor"
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding ExitCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddRowCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateRowCommand}"/>
        <KeyBinding Gesture="Ctrl+Delete" Command="{Binding DeleteRowCommand}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}"/>
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:FileTabViewModel">
            <views:FileTabView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="280,Auto,*" RowDefinitions="Auto,*,Auto">

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Grid.ColumnSpan="3">
            <MenuItem Header="_File">
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Save _All" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}"/>
                <Separator/>
                <MenuItem Header="_Refresh Workspace" Command="{Binding RefreshWorkspaceCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGesture="Ctrl+Q" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem Header="_Add Row" InputGesture="Ctrl+N" Command="{Binding AddRowCommand}"/>
                <MenuItem Header="_Duplicate Row" InputGesture="Ctrl+D" Command="{Binding DuplicateRowCommand}"/>
                <MenuItem Header="De_lete Row" InputGesture="Ctrl+Delete" Command="{Binding DeleteRowCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Workspace Settings" Command="{Binding OpenWorkspaceSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Catalog Sidebar -->
        <Border Grid.Row="1" Grid.Column="0"
                BorderBrush="#202225"
                BorderThickness="0,0,1,0"
                Background="#2f3136">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Catalogs" FontWeight="SemiBold" Margin="12,10,12,6"
                           Foreground="#dcddde"/>
                <TreeView Grid.Row="1"
                          ItemsSource="{Binding Catalogs}"
                          Margin="4,0"
                          DoubleTapped="TreeView_DoubleTapped">
                    <TreeView.DataTemplates>
                        <!-- Template for catalog nodes -->
                        <TreeDataTemplate DataType="vm:CatalogNode" ItemsSource="{Binding Files}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Files.Count, StringFormat='({0})'}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           FontSize="12"/>
                            </StackPanel>
                        </TreeDataTemplate>
                        <!-- Template for file nodes inside catalogs -->
                        <DataTemplate DataType="vm:FileNode">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="4"
                      ResizeDirection="Columns"
                      Background="Transparent"/>

        <!-- Main Content Panel -->
        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*">
            <!-- File Title Header -->
            <Border Grid.Row="0"
                    Background="#36393f"
                    BorderBrush="#202225"
                    BorderThickness="0,0,0,1"
                    Padding="16,10"
                    IsVisible="{Binding HasOpenTabs}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding ActiveTab.Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#ffffff"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="*"
                               IsVisible="{Binding ActiveTab.HasUnsavedChanges}"
                               Foreground="Orange"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Search/Filter Bar -->
            <Border Grid.Row="1"
                    Background="#2f3136"
                    Padding="12,8"
                    IsVisible="{Binding HasOpenTabs}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Search:"
                               VerticalAlignment="Center"
                               Foreground="#b9bbbe"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="Filter entries... (Ctrl+F)"
                             MinWidth="200"
                             MaxWidth="400"/>
                    <Button Grid.Column="2"
                            Content="Clear"
                            Command="{Binding ClearSearchCommand}"
                            Margin="8,0,0,0"
                            IsVisible="{Binding HasSearchText}"/>
                </Grid>
            </Border>

            <!-- Active Tab Content -->
            <ContentControl Grid.Row="2"
                            Content="{Binding ActiveTab}"
                            IsVisible="{Binding HasOpenTabs}"/>
        </Grid>

        <!-- Welcome message when no tabs open -->
        <Border Grid.Row="1" Grid.Column="2"
                IsVisible="{Binding !HasOpenTabs}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="15" HorizontalAlignment="Center">
                <TextBlock Text="TOR Tools"
                           FontSize="28"
                           FontWeight="Light"
                           Foreground="#dcddde"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="XML Editor for The Old Realms"
                           FontSize="14"
                           Foreground="#b9bbbe"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Double-click a file in the sidebar to open it"
                           FontSize="12"
                           Foreground="#72767d"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="3"
                BorderBrush="#202225"
                BorderThickness="0,1,0,0"
                Background="#2f3136"
                Padding="12,6">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="#dcddde"/>
                <TextBlock Grid.Column="1" Text="{Binding RowCountText}" Margin="20,0" VerticalAlignment="Center"
                           Foreground="#b9bbbe"/>
                <TextBlock Grid.Column="2" Text="{Binding WorkspacePath}"
                           Foreground="#72767d"
                           VerticalAlignment="Center"
                           FontSize="11"/>
            </Grid>
        </Border>
    </Grid>

</Window>
