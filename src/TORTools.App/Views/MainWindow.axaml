<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TORTools.App.ViewModels"
        xmlns:tvm="using:TORTools.App.ViewModels.Translation"
        xmlns:views="using:TORTools.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="TORTools.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TOR Tools - XML Editor"
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding ExitCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddRowCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateRowCommand}"/>
        <KeyBinding Gesture="Ctrl+Delete" Command="{Binding DeleteRowCommand}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}"/>
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:FileTabViewModel">
            <views:FileTabView/>
        </DataTemplate>
        <DataTemplate DataType="tvm:TranslationSheetTabViewModel">
            <views:TranslationSheetView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="280,Auto,*" RowDefinitions="Auto,*,Auto">

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Grid.ColumnSpan="3">
            <MenuItem Header="_File">
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Save _All" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}"/>
                <Separator/>
                <MenuItem Header="_Refresh Workspace" Command="{Binding RefreshWorkspaceCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGesture="Ctrl+Q" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem Header="_Add Row" InputGesture="Ctrl+N" Command="{Binding AddRowCommand}"/>
                <MenuItem Header="_Duplicate Row" InputGesture="Ctrl+D" Command="{Binding DuplicateRowCommand}"/>
                <MenuItem Header="De_lete Row" InputGesture="Ctrl+Delete" Command="{Binding DeleteRowCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Workspace Settings" Command="{Binding OpenWorkspaceSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0"
                BorderBrush="#202225"
                BorderThickness="0,0,1,0"
                Background="#2f3136">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Catalogs" FontWeight="SemiBold" Margin="12,10,12,6"
                           Foreground="#dcddde"/>
                <TreeView Grid.Row="1"
                          ItemsSource="{Binding Catalogs}"
                          Margin="4,0"
                          DoubleTapped="TreeView_DoubleTapped">
                    <TreeView.DataTemplates>
                        <!-- Template for catalog nodes -->
                        <TreeDataTemplate DataType="vm:CatalogNode" ItemsSource="{Binding Files}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Files.Count, StringFormat='({0})'}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           FontSize="12"/>
                            </StackPanel>
                        </TreeDataTemplate>
                        <!-- Template for file nodes inside catalogs -->
                        <DataTemplate DataType="vm:FileNode">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                        </DataTemplate>
                        <!-- Template for Translations catalog (TranslationsSidebarViewModel) -->
                        <TreeDataTemplate DataType="tvm:TranslationsSidebarViewModel" ItemsSource="{Binding Languages}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Translations" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Languages.Count, StringFormat='({0})'}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           FontSize="12"/>
                            </StackPanel>
                        </TreeDataTemplate>
                        <!-- Template for language nodes (under Translations catalog) -->
                        <TreeDataTemplate DataType="tvm:LanguageTreeItem" ItemsSource="{Binding Modules}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </TreeDataTemplate>
                        <!-- Template for translation file/module nodes -->
                        <TreeDataTemplate DataType="tvm:TranslationFileTreeItem" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                       FontWeight="{Binding IsModule, Converter={x:Static vm:Converters.BoolToFontWeight}}"/>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
                <!-- Add Language Button at bottom -->
                <Button Grid.Row="2"
                        Content="+ Add Language"
                        HorizontalAlignment="Stretch"
                        Margin="8,4,8,8"
                        Click="AddLanguage_Click"
                        IsVisible="{Binding TranslationsSidebar, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="4"
                      ResizeDirection="Columns"
                      Background="Transparent"/>

        <!-- Main Content Panel -->
        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*">
            <!-- File Title Header -->
            <Border Grid.Row="0"
                    Background="#36393f"
                    BorderBrush="#202225"
                    BorderThickness="0,0,0,1"
                    Padding="16,10"
                    IsVisible="{Binding HasAnyOpenTab}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding CurrentTabTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#ffffff"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="*"
                               IsVisible="{Binding CurrentTabHasUnsavedChanges}"
                               Foreground="Orange"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Search/Filter Bar (only for file tabs, not translation tabs) -->
            <Border Grid.Row="1"
                    Background="#2f3136"
                    Padding="12,8"
                    IsVisible="{Binding HasOpenTabs}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Search:"
                               VerticalAlignment="Center"
                               Foreground="#b9bbbe"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="Filter entries... (Ctrl+F)"
                             MinWidth="200"
                             MaxWidth="400"/>
                    <!-- Loading indicator -->
                    <TextBlock Grid.Column="2"
                               Text="Filtering..."
                               Foreground="#72767d"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               IsVisible="{Binding ActiveTab.IsFiltering, FallbackValue=False}"/>
                    <Button Grid.Column="3"
                            Content="Clear"
                            Command="{Binding ClearSearchCommand}"
                            Margin="8,0,0,0"
                            IsVisible="{Binding HasSearchText}"/>
                </Grid>
            </Border>

            <!-- Active Tab Content (either file or translation tab) -->
            <ContentControl Grid.Row="2"
                            Content="{Binding CurrentTabContent}"
                            IsVisible="{Binding HasAnyOpenTab}"/>
        </Grid>

        <!-- Welcome message when no tabs open -->
        <Border Grid.Row="1" Grid.Column="2"
                IsVisible="{Binding !HasAnyOpenTab}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="15" HorizontalAlignment="Center">
                <TextBlock Text="TOR Tools"
                           FontSize="28"
                           FontWeight="Light"
                           Foreground="#dcddde"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="XML Editor for The Old Realms"
                           FontSize="14"
                           Foreground="#b9bbbe"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Double-click a file in the sidebar to open it"
                           FontSize="12"
                           Foreground="#72767d"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- Error message overlay -->
        <Border Grid.Row="1" Grid.Column="2"
                IsVisible="{Binding HasError}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1e1f22"
                BorderBrush="#f04747"
                BorderThickness="2"
                CornerRadius="8"
                Padding="30,20"
                MaxWidth="700">
            <StackPanel Spacing="15">
                <TextBlock Text="Error"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#f04747"
                           HorizontalAlignment="Center"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}"
                                     FontSize="13"
                                     Foreground="#dcddde"
                                     TextWrapping="Wrap"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center"/>
                <Button Content="Dismiss"
                        Command="{Binding ClearErrorCommand}"
                        HorizontalAlignment="Center"
                        Padding="20,8"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="3"
                BorderBrush="#202225"
                BorderThickness="0,1,0,0"
                Background="#2f3136"
                Padding="12,6">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="#dcddde"/>
                <TextBlock Grid.Column="1" Text="{Binding RowCountText}" Margin="20,0" VerticalAlignment="Center"
                           Foreground="#b9bbbe"/>
                <TextBlock Grid.Column="2" Text="{Binding WorkspacePath}"
                           Foreground="#72767d"
                           VerticalAlignment="Center"
                           FontSize="11"/>
            </Grid>
        </Border>
    </Grid>

</Window>
