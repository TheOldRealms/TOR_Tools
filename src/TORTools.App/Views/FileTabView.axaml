<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TORTools.App.ViewModels"
             xmlns:converters="using:TORTools.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TORTools.App.Views.FileTabView"
             x:DataType="vm:FileTabViewModel">

    <UserControl.Resources>
        <converters:SeverityToColorConverter x:Key="SeverityToColorConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Include cell styles from external file -->
        <StyleInclude Source="/Themes/CellStyles.axaml"/>
        <!-- Style for new entry rows (Discord green) -->
        <Style Selector="DataGridRow.newEntry">
            <Setter Property="Background" Value="#2d3d2d"/>
        </Style>
        <Style Selector="DataGridRow.newEntry:selected">
            <Setter Property="Background" Value="#3d4d3d"/>
        </Style>
        <Style Selector="DataGridRow.newEntry DataGridCell">
            <Setter Property="Foreground" Value="#3ba55d"/>
        </Style>
        <Style Selector="DataGridRow.newEntry DataGridCell TextBlock">
            <Setter Property="Foreground" Value="#3ba55d"/>
        </Style>

        <!-- Style for equipment set roster group alternating rows -->
        <Style Selector="DataGridRow.rosterGroupAlt">
            <Setter Property="Background" Value="#2a2d32"/>
        </Style>
        <Style Selector="DataGridRow.rosterGroupAlt:selected">
            <Setter Property="Background" Value="#3a3d42"/>
        </Style>

        <!-- Style for rows selected for copy (Discord blurple accent) -->
        <Style Selector="DataGridRow.selectedForCopy">
            <Setter Property="Background" Value="#3c4270"/>
        </Style>
        <Style Selector="DataGridRow.selectedForCopy DataGridCell">
            <Setter Property="Background" Value="#3c4270"/>
            <Setter Property="BorderBrush" Value="#5865f2"/>
            <Setter Property="BorderThickness" Value="0,2,0,2"/>
        </Style>
        <Style Selector="DataGridRow.selectedForCopy DataGridCell:nth-child(1)">
            <Setter Property="BorderThickness" Value="2,2,0,2"/>
        </Style>
        <Style Selector="DataGridRow.selectedForCopy DataGridCell:nth-last-child(1)">
            <Setter Property="BorderThickness" Value="0,2,2,2"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Toolbar for row operations -->
        <Border Grid.Row="0"
                Background="#2f3136"
                BorderBrush="#202225"
                BorderThickness="0,0,0,1"
                Padding="4"
                IsVisible="{Binding !HasError}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- Standard add row (for non-equipment-set files) -->
                <Button Content="+ Add Row"
                        Command="{Binding AddRowCommand}"
                        ToolTip.Tip="Add new row after selection (Ctrl+Shift+A)"
                        Padding="8,4"
                        Background="#3ba55d"
                        Foreground="#ffffff"
                        IsVisible="{Binding !HasNestedVariations}"/>
                <!-- Equipment set buttons -->
                <Button Content="+ New Roster"
                        Command="{Binding AddRosterCommand}"
                        ToolTip.Tip="Add a new empty roster with one variation"
                        Padding="8,4"
                        Background="#3ba55d"
                        Foreground="#ffffff"
                        IsVisible="{Binding HasNestedVariations}"/>
                <Button Content="+ Variation"
                        Command="{Binding AddVariationCommand}"
                        ToolTip.Tip="Add new variation to the selected roster"
                        Padding="8,4"
                        Background="#43b581"
                        Foreground="#ffffff"
                        IsVisible="{Binding HasNestedVariations}"/>
                <!-- Standard duplicate (for non-equipment-set files) -->
                <Button Content="Duplicate"
                        Command="{Binding DuplicateRowCommand}"
                        ToolTip.Tip="Duplicate selected row (Ctrl+D)"
                        Padding="8,4"
                        IsVisible="{Binding !HasNestedVariations}"/>
                <!-- Equipment set duplicate buttons -->
                <Button Content="Dup. Variation"
                        Command="{Binding DuplicateVariationCommand}"
                        ToolTip.Tip="Duplicate the selected variation"
                        Padding="8,4"
                        IsVisible="{Binding HasNestedVariations}"/>
                <Button Content="Dup. Roster"
                        Command="{Binding DuplicateRosterCommand}"
                        ToolTip.Tip="Duplicate the entire roster with all variations"
                        Padding="8,4"
                        Background="#2196F3"
                        Foreground="#ffffff"
                        IsVisible="{Binding HasNestedVariations}"/>
                <Button Content="Delete"
                        Command="{Binding DeleteRowCommand}"
                        ToolTip.Tip="Delete selected row (Ctrl+Del)"
                        Padding="8,4"
                        Background="#ed4245"
                        Foreground="#ffffff"/>
                <Separator Width="1" Background="#40444b" Margin="8,0"/>
                <TextBlock Text="{Binding Rows.Count, StringFormat='Rows: {0}'}"
                           VerticalAlignment="Center"
                           Foreground="#b9bbbe"/>
                <Separator Width="1" Background="#40444b" Margin="8,0"/>
                <CheckBox Content="Show Removed"
                          IsChecked="{Binding ShowRemovedEntries}"
                          ToolTip.Tip="Show entries deleted during this session"
                          VerticalAlignment="Center"
                          Foreground="#b9bbbe"/>
                <Separator Width="1" Background="#40444b" Margin="8,0"/>
                <Button Content="Reload"
                        Command="{Binding ReloadCommand}"
                        ToolTip.Tip="Reload file from disk (picks up git changes)"
                        Padding="8,4"/>
            </StackPanel>
        </Border>

        <!-- Error message if loading failed -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Background="#20FF0000"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- DataGrid when loaded successfully -->
        <Border Grid.Row="1" Padding="0,0,8,0">
            <DataGrid x:Name="EntryGrid"
                      ItemsSource="{Binding DisplayRows}"
                      SelectedIndex="{Binding SelectedIndex}"
                      IsVisible="{Binding !HasError}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="All"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      HeadersVisibility="Column"
                      FrozenColumnCount="2"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      LoadingRow="OnDataGridLoadingRow">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <!-- Standard row operations (for non-equipment-set files) -->
                    <MenuItem Header="Insert Row Above" Command="{Binding InsertRowAboveCommand}"
                              IsVisible="{Binding !HasNestedVariations}">
                        <MenuItem.Icon>
                            <TextBlock Text="+" FontWeight="Bold" Foreground="#4CAF50"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Insert Row Below" Command="{Binding AddRowCommand}"
                              IsVisible="{Binding !HasNestedVariations}">
                        <MenuItem.Icon>
                            <TextBlock Text="+" FontWeight="Bold" Foreground="#4CAF50"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator IsVisible="{Binding !HasNestedVariations}"/>

                    <!-- Equipment set operations -->
                    <MenuItem Header="Add New Roster" Command="{Binding AddRosterCommand}"
                              IsVisible="{Binding HasNestedVariations}">
                        <MenuItem.Icon>
                            <TextBlock Text="+" FontWeight="Bold" Foreground="#4CAF50"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Add Variation" Command="{Binding AddVariationCommand}"
                              IsVisible="{Binding HasNestedVariations}">
                        <MenuItem.Icon>
                            <TextBlock Text="+" FontWeight="Bold" Foreground="#43b581"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator IsVisible="{Binding HasNestedVariations}"/>
                    <MenuItem Header="Duplicate Variation" Command="{Binding DuplicateVariationCommand}"
                              IsVisible="{Binding HasNestedVariations}">
                        <MenuItem.Icon>
                            <TextBlock Text="⧉" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Duplicate Roster" Command="{Binding DuplicateRosterCommand}"
                              IsVisible="{Binding HasNestedVariations}">
                        <MenuItem.Icon>
                            <TextBlock Text="⧉" FontSize="14" Foreground="#2196F3"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator IsVisible="{Binding HasNestedVariations}"/>

                    <!-- Copy/Paste (available for all files) -->
                    <MenuItem Header="Copy Row" InputGesture="Ctrl+C" Command="{Binding CopyRowCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="📋" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Paste Row" InputGesture="Ctrl+V" Command="{Binding PasteRowCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="📄" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>

                    <!-- Duplicate Row (only for non-equipment-set files) -->
                    <MenuItem Header="Duplicate Row" Command="{Binding DuplicateRowCommand}"
                              IsVisible="{Binding !HasNestedVariations}">
                        <MenuItem.Icon>
                            <TextBlock Text="⧉" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator IsVisible="{Binding !HasNestedVariations}"/>

                    <!-- Delete (available for all files) -->
                    <MenuItem Header="Delete Row" Command="{Binding DeleteRowCommand}" Foreground="#C62828">
                        <MenuItem.Icon>
                            <TextBlock Text="✕" FontWeight="Bold" Foreground="#C62828"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        </Border>

        <!-- Validation Panel -->
        <Border Grid.Row="2"
                Background="#2f3136"
                BorderBrush="#202225"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding !HasError}">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Validation Header (always visible) -->
                <Border Grid.Row="0"
                        Background="#202225"
                        Padding="8,4"
                        Cursor="Hand"
                        PointerPressed="OnValidationHeaderClick">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Validation"
                                   FontWeight="SemiBold"
                                   Foreground="#dcddde"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ValidationSummary}"
                                   Foreground="#b9bbbe"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Button Grid.Column="3"
                                Content="Validate"
                                Command="{Binding RunValidationCommand}"
                                Padding="8,2"
                                FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Validation Issues List (expandable) -->
                <Border Grid.Row="1"
                        IsVisible="{Binding IsValidationPanelExpanded}"
                        MaxHeight="150"
                        Background="#36393f">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ValidationIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            PointerPressed="OnValidationIssueClick">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="Background" Value="#40444b"/>
                                            </Style>
                                        </Border.Styles>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}"
                                                    CornerRadius="2"
                                                    Padding="4,1">
                                                <TextBlock Text="{Binding Severity}"
                                                           FontSize="10"
                                                           Foreground="#ffffff"/>
                                            </Border>
                                            <TextBlock Text="{Binding RowIndex, StringFormat='Row {0}'}"
                                                       FontSize="11"
                                                       Foreground="#72767d"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AttributeName}"
                                                       FontSize="11"
                                                       Foreground="#5865f2"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="11"
                                                       Foreground="#dcddde"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
