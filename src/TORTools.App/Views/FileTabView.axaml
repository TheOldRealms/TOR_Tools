<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TORTools.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TORTools.App.Views.FileTabView"
             x:DataType="vm:FileTabViewModel">

    <UserControl.Styles>
        <!-- Style for new entry rows (Discord green) -->
        <Style Selector="DataGridRow.newEntry">
            <Setter Property="Background" Value="#2d3d2d"/>
        </Style>
        <Style Selector="DataGridRow.newEntry:selected">
            <Setter Property="Background" Value="#3d4d3d"/>
        </Style>
        <Style Selector="DataGridRow.newEntry DataGridCell">
            <Setter Property="Foreground" Value="#3ba55d"/>
        </Style>
        <Style Selector="DataGridRow.newEntry DataGridCell TextBlock">
            <Setter Property="Foreground" Value="#3ba55d"/>
        </Style>

        <!-- Style for rows selected for copy (Discord blurple accent) -->
        <Style Selector="DataGridRow.selectedForCopy">
            <Setter Property="Background" Value="#3c4270"/>
        </Style>
        <Style Selector="DataGridRow.selectedForCopy DataGridCell">
            <Setter Property="Background" Value="#3c4270"/>
            <Setter Property="BorderBrush" Value="#5865f2"/>
            <Setter Property="BorderThickness" Value="0,2,0,2"/>
        </Style>
        <Style Selector="DataGridRow.selectedForCopy DataGridCell:nth-child(1)">
            <Setter Property="BorderThickness" Value="2,2,0,2"/>
        </Style>
        <Style Selector="DataGridRow.selectedForCopy DataGridCell:nth-last-child(1)">
            <Setter Property="BorderThickness" Value="0,2,2,2"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar for row operations -->
        <Border Grid.Row="0"
                Background="#2f3136"
                BorderBrush="#202225"
                BorderThickness="0,0,0,1"
                Padding="4"
                IsVisible="{Binding !HasError}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="+ Add Row"
                        Command="{Binding AddRowCommand}"
                        ToolTip.Tip="Add new row after selection (Ctrl+Shift+A)"
                        Padding="8,4"
                        Background="#3ba55d"
                        Foreground="#ffffff"/>
                <Button Content="Duplicate"
                        Command="{Binding DuplicateRowCommand}"
                        ToolTip.Tip="Duplicate selected row (Ctrl+D)"
                        Padding="8,4"/>
                <Button Content="Delete"
                        Command="{Binding DeleteRowCommand}"
                        ToolTip.Tip="Delete selected row (Del)"
                        Padding="8,4"
                        Background="#ed4245"
                        Foreground="#ffffff"/>
                <Separator Width="1" Background="#40444b" Margin="8,0"/>
                <TextBlock Text="{Binding Rows.Count, StringFormat='Rows: {0}'}"
                           VerticalAlignment="Center"
                           Foreground="#b9bbbe"/>
            </StackPanel>
        </Border>

        <!-- Error message if loading failed -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Background="#20FF0000"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- DataGrid when loaded successfully -->
        <DataGrid x:Name="EntryGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  SelectedIndex="{Binding SelectedIndex}"
                  IsVisible="{Binding !HasError}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  LoadingRow="OnDataGridLoadingRow">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Insert Row Above" Command="{Binding InsertRowAboveCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="+" FontWeight="Bold" Foreground="#4CAF50"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Insert Row Below" Command="{Binding AddRowCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="+" FontWeight="Bold" Foreground="#4CAF50"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Copy Row" InputGesture="Ctrl+C" Command="{Binding CopyRowCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="📋" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Paste Row" InputGesture="Ctrl+V" Command="{Binding PasteRowCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="📄" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Duplicate Row" Command="{Binding DuplicateRowCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="⧉" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Delete Row" Command="{Binding DeleteRowCommand}" Foreground="#C62828">
                        <MenuItem.Icon>
                            <TextBlock Text="✕" FontWeight="Bold" Foreground="#C62828"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>

</UserControl>
