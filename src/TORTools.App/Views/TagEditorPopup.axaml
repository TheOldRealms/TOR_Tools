<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TORTools.App.Views"
        x:Class="TORTools.App.Views.TagEditorPopup"
        Title="Edit Tags"
        Width="500"
        Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="400"
        MinHeight="400">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="12">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold" Text="Edit Tags" />
            <TextBlock x:Name="SubHeaderText" FontSize="12" Foreground="#666666" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Current tags (editable text) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Current Tags (comma-separated):" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="CurrentTagsBox"
                     Height="60"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="Enter tags..." />
        </StackPanel>

        <!-- Available tags section header -->
        <TextBlock Grid.Row="2" Text="Available Tags (double-click to add):" FontWeight="SemiBold" Margin="0,8,0,4" />

        <!-- Filter and list -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*">
            <TextBox x:Name="FilterBox"
                     Grid.Row="0"
                     PlaceholderText="Type to filter..."
                     Margin="0,0,0,4" />

            <ListBox x:Name="AvailableTagsList"
                     Grid.Row="1"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="views:TagDefinition">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Id}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       MinWidth="150" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Description}"
                                       Foreground="#888888"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Tag description when selected -->
        <Border Grid.Row="4"
                BorderThickness="1"
                BorderBrush="#444444"
                Background="#252525"
                CornerRadius="4"
                Padding="8"
                Margin="0,8,0,8"
                MinHeight="50">
            <TextBlock x:Name="TagDescription"
                       TextWrapping="Wrap"
                       Foreground="#AAAAAA"
                       FontStyle="Italic"
                       Text="Select a tag to see its description" />
        </Border>

        <!-- Button row -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="OnCancel" Width="80" />
            <Button x:Name="SaveButton" Content="Save" Click="OnSave" Width="80" Classes="accent" />
        </StackPanel>
    </Grid>
</Window>
