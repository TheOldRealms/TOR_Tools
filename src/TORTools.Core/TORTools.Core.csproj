<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TORTools.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 3D Model Loading for Weapon Parts Editor -->
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
    <!-- SpritePack TPAC + RDC payload compression. -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <!-- SpritePack TPAC source-hash + RDC hash-block derivation. -->
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    <!-- SpritePack atlas pipeline. The ImageSharp 3.1.x advisories
         (GHSA-v76p-62qx-wwq2, GHSA-wmxv-xphr-5c9g) are decoder-side,
         triggered only by maliciously crafted images; we decode trusted
         mod-author PNGs offline, so the exposure does not apply.
         Revisit on upgrade. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" NoWarn="NU1903;NU1902" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>

</Project>
